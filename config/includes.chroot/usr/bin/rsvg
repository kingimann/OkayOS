#!/bin/sh
# Compatibility shim for the legacy `rsvg` command, which modern librsvg2-bin
# replaced with `rsvg-convert`. live-build's older boot-splash generator still
# calls `rsvg --format png --height H --width W in.svg out.png`; translate that
# to the rsvg-convert CLI. Harmless if never used.
fmt=png
height=
width=
positionals=
while [ "$#" -gt 0 ]; do
	case "$1" in
		--format) fmt="$2"; shift 2 ;;
		--height) height="$2"; shift 2 ;;
		--width)  width="$2";  shift 2 ;;
		--*)      shift ;;
		*)        positionals="$positionals $1"; shift ;;
	esac
done

# shellcheck disable=SC2086
set -- $positionals
in_svg="$1"
out_png="$2"

exec rsvg-convert -f "$fmt" ${height:+-h "$height"} ${width:+-w "$width"} \
	-o "$out_png" "$in_svg"
