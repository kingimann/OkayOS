#!/bin/sh
# Runs inside the chroot during build. Stamps OkayOS identity onto the system.
set -e

echo "I: applying OkayOS branding"

cat > /etc/os-release <<'EOF'
PRETTY_NAME="OkayOS 0.1 (Genesis)"
NAME="OkayOS"
VERSION_ID="0.1"
VERSION="0.1 (Genesis)"
VERSION_CODENAME=genesis
ID=okayos
ID_LIKE=debian
HOME_URL="https://github.com/kingimann/OkayOS"
SUPPORT_URL="https://github.com/kingimann/OkayOS/issues"
BUG_REPORT_URL="https://github.com/kingimann/OkayOS/issues"
EOF

# Mirror for tools that read /etc/lsb-release
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=OkayOS
DISTRIB_RELEASE=0.1
DISTRIB_CODENAME=genesis
DISTRIB_DESCRIPTION="OkayOS 0.1 (Genesis)"
EOF

# Default hostname (live boot also sets this via bootappend)
echo "okayos" > /etc/hostname

# Issue shown at the login prompt on the console
cat > /etc/issue <<'EOF'

  OkayOS 0.1 (Genesis)  \l
  Welcome. It's gonna be okay.

EOF

# neofetch will pick up the new os-release automatically.
echo "I: OkayOS branding applied"
